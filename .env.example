# Product Passport — environment configuration
# Copy to .env.local and fill in real credentials. Never commit .env.local.

# ── AI provider (OpenAI-compatible endpoint) ────────────────────────────────
AI_PROVIDER=octopus
OCTOPUS_BASE_URL=https://octopus.lvyufeng.dpdns.org/v1
OCTOPUS_API_KEY=
AI_MODEL=deepseek-v4.1-flash
AI_VISION_MODEL=deepseek-v4.1-flash
AI_VISION_ENABLED=0
AI_JSON_MODE=1
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_CONCURRENCY=2
AI_GUEST_DAILY_LIMIT=60
AI_DAILY_GATEWAY_LIMIT=4000
# Configure only when a trusted proxy strips and overwrites this header with one client IP.
# AI_TRUSTED_VISITOR_HEADER=
# Optional provider tariff for estimated cost only.
# AI_INPUT_PRICE_PER_MILLION=
# AI_OUTPUT_PRICE_PER_MILLION=
# AI_COST_CURRENCY=

# ── Search provider ─────────────────────────────────────────────────────────
# tavily | exa | serper | local | none
# `local` uses the bundled imported-evidence corpus and is NEVER presented as
# live web search. Configure a real provider for LIVE_SEARCH mode.
SEARCH_PROVIDER=local
SEARCH_API_KEY=
SEARCH_TIMEOUT_MS=20000
SEARCH_MAX_RESULTS=8

# ── Runtime mode ────────────────────────────────────────────────────────────
# LIVE requires an AI key; if no key is present the app falls back to DEMO mode
# and labels every generated artifact accordingly.
APP_MODE=LIVE
DEMO_MODE=0

# ── Persistence ─────────────────────────────────────────────────────────────
DATABASE_PATH=data/product-passport.db
UPLOAD_DIR=data/uploads

# ── Research controls ───────────────────────────────────────────────────────
RESEARCH_CONCURRENCY=2
MIN_COMPARABLE_COVERAGE=0.6
FETCH_TIMEOUT_MS=18000
FETCH_MAX_BYTES=2500000
FETCH_MAX_CHARS=45000
FETCH_USER_AGENT=ProductPassportBot/1.0 (+research; contact: operator@example.com)
DISABLE_RETAIL_PROBE=0
MAX_UPLOAD_BYTES=8388608
# Shopify development store only. Configure API scopes read_products and write_products.
# LOCALMATE_SHOPIFY_TEST_SHOP=your-dev-store.myshopify.com
# LOCALMATE_SHOPIFY_ADMIN_TOKEN=

# UK Amazon compliance precheck. Worker runs the DeepSeekHarness Python bridge.
# Defaults to ~/Documents/deepseek-harness/default-workspace/localmate on this machine.
# LOCALMATE_COMPLIANCE_ENGINE_DIR=/absolute/path/to/deepseek-harness/default-workspace/localmate
# LOCALMATE_COMPLIANCE_PYTHON=python3

# Optional authenticated sender for LocalMate freight inquiries. Use 587 with STARTTLS or 465 with TLS.
# LOCALMATE_SMTP_HOST=
# LOCALMATE_SMTP_PORT=587
# LOCALMATE_SMTP_USER=
# LOCALMATE_SMTP_PASSWORD=
# LOCALMATE_SMTP_FROM=
# Optional path to a font covering the buyer's language (TTF or OTF).
# LOCALMATE_QUOTE_FONT=


# 可选。墨西哥 Mercado Libre 项目用 OpenAI Responses 联网搜索补充商品链接。
# 仅传商品名称和目标国家。填入你的 OpenAI 项目密钥及支持 web_search 的模型。
# 使用 APP_MODE=LIVE。未配置时可使用已导入的样本和手工来源。
# OPENAI_API_KEY=
# OPENAI_RESEARCH_MODEL=
